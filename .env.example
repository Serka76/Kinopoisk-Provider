# Скопируй в .env рядом с docker-compose.yml и впиши свои значения.
# Файл .env уже в .gitignore — ключи в репозиторий не уедут.

# Ключ от бота @poiskkinodev_bot — обязательный.
POISKKINO_API_KEY=

# Ключ TMDB (v3 API Key) — нужен для фото актёров и запасной карточки,
# когда у poiskkino.dev кончается суточная квота. Необязательный.
TMDB_API_KEY=

# Только если поднимаешь сайдкар hysteria-proxy.
HYSTERIA2_URL=
