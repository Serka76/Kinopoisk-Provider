version: "3.8"

services:
  # Необязательный сайдкар: клиент Hysteria2, который поднимает локальный
  # SOCKS5-прокси для обхода блокировки TMDB. Конфиг он собирает сам из
  # ссылки HYSTERIA2_URL при старте. Не нужен — удали этот сервис,
  # depends_on и переменную TMDB_PROXY_URL ниже.
  hysteria-proxy:
    build: ./hysteria-proxy
    container_name: hysteria-proxy
    restart: unless-stopped
    environment:
      # Ссылка целиком, как есть:
      # hysteria2://AUTH@HOST:PORT/?insecure=1&sni=example.com#name
      - HYSTERIA2_URL=${HYSTERIA2_URL}

  kinopoisk-provider:
    build: .
    container_name: kinopoisk-provider
    restart: unless-stopped
    ports:
      - "8384:8000"
    environment:
      # Ключи подставляются из файла .env рядом с этим файлом — так они
      # не попадут в git вместе с docker-compose.yml.
      - POISKKINO_API_KEY=${POISKKINO_API_KEY}
      - TMDB_API_KEY=${TMDB_API_KEY}
      # Необязательно — см. комментарий у hysteria-proxy выше.
      - TMDB_PROXY_URL=socks5://hysteria-proxy:1080
    depends_on:
      - hysteria-proxy
